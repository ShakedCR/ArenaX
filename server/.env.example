PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/arenax
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_jwt_secret
SESSION_SECRET=change_this_session_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Default model for development / stronger machines.
# On low-memory production servers, ArenaX can use llama3.2:3b instead.

OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_TIMEOUT_MS=30000
OLLAMA_GENERATE_TIMEOUT_MS=120000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
